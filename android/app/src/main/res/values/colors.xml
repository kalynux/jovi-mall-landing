<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The accent Android tints a push notification with — the small icon, the
      app name in the shade header, and the collapsed-notification chip.

      Named in the manifest as
      `com.google.firebase.messaging.default_notification_color`. Without it the
      system picks its own grey, which reads as a notification from nothing in
      particular. Brand green, the same value the `brand` custom property
      carries in globals.css.
    -->
    <color name="notification_color">#068554</color>

    <!--
      The splash field, behind `drawable/splash.xml`.

      Kept in step with `SplashScreen.backgroundColor` in capacitor.config.ts:
      the plugin paints that colour on the ImageView it hosts the splash in, so
      a mismatch shows as a band around the artwork on any screen whose aspect
      ratio differs from the drawable's.
    -->
    <color name="splash_background">#068554</color>

</resources>
