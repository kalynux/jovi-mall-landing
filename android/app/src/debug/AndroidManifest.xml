<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the debug APK's manifest only. Points the app at the debug-only
  network security config beside this file, which permits plain HTTP to the
  development API host and nothing else. The release manifest never sees it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
