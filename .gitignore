# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no values — only the list of keys.
!.env.example
# `.env.production` is committed on purpose as of 2026-09-13. Every value in it
# is NEXT_PUBLIC_, which Next inlines into the bundle sent to every visitor, so
# none of it is secret — and CI has no other way to learn the production hosts.
# `.env.local` stays ignored and still overrides it locally.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# signing material — never commit
*.keystore
*.jks
# Firebase config. Root-anchored was wrong: the file Gradle actually reads lives
# at android/app/google-services.json. Unanchored so it is ignored wherever it lands.
# It is not a secret (the API key ships inside every APK) but it names the project,
# and a fork building against someone else's Firebase silently sends nothing.
google-services.json
/GoogleService-Info.plist

# capacitor — the native projects ARE committed, per Capacitor's own guidance.
# They carry hand-written configuration that `npx cap add` does not regenerate:
# the deep-link intent filters, the debug-only cleartext policy, and later the
# push-notification service. What is ignored is everything built from them, plus
# the web assets `cap sync` copies in from out/ on every build.
/android/app/build/
/android/build/
/android/.gradle/
/android/captures/
/android/local.properties
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/ios/App/Pods/
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/App/App/capacitor.plugins.json
/ios/DerivedData/
