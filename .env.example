# Copy to .env.local and fill in. Everything here is NEXT_PUBLIC_, so treat it
# as shipped-to-the-browser configuration, never as secrets.

# Backend API origin. Defaults to http://localhost:8022 when unset.
NEXT_PUBLIC_API_URL=http://localhost:8022

# Canonical site origin, used for metadata/sitemap/robots.
# Defaults to https://wimall.com when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp bot number in E.164 (e.g. +237XXXXXXXXX). Every customer CTA deep
# links here. Falls back to the placeholder in src/lib/constants.ts, which is
# NOT a real number — set this before shipping.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Agent app store listings. Leave empty until published: the download buttons
# render disabled with a "Coming soon" pill rather than as dead links.
NEXT_PUBLIC_AGENT_APP_ANDROID_URL=
NEXT_PUBLIC_AGENT_APP_IOS_URL=
