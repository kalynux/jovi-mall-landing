# Wi-Mall storefront + marketing site (Next.js) — environment variables.
#
# ─── Which file is read when ──────────────────────────────────────────────────
# Next loads these by NODE_ENV, not by a `--mode` flag (it has none, unlike the
# Vite dashboards). Later entries win:
#
#   npm run dev            .env  →  .env.development  →  .env.local
#   npm run build          .env  →  .env.production   →  .env.local
#   npm run build:native   .env  →  .env.production   →  .env.local  →  .env.mobile
#
# `.env.mobile` is NOT a Next convention — `scripts/build-native.mjs` loads it
# itself and passes it to the build, because the app needs different values from
# the website built from the same source. It is the last word for that build.
#
# `.env.local` stays what Next means by it: personal overrides, never committed,
# and it beats both .env.development and .env.production.
#
# Only THIS file is committed (see .gitignore: `.env*` with `!.env.example`).
# Copy it to the three real files, or just to `.env.local` for a quick start.
#
# ─── Production hosts ─────────────────────────────────────────────────────────
#   this site        https://wi-mall.com
#   API              https://api.wi-mall.com
#   vendor dashboard https://vendor.wi-mall.com
#   agency dashboard https://agency.wi-mall.com
#   agent web app    https://agent.wi-mall.com
#
# Note the hyphen: `wimall.com` is a different company's domain and must never
# be used anywhere.
#
# Everything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle and
# shipped to every visitor. Treat it as public configuration, never as a secret.
# `NATIVE_API_URL` is the one exception below and is build-time only.

# ─── Origins ──────────────────────────────────────────────────────────────────

# Backend API origin. Defaults to http://localhost:8022 when unset.
NEXT_PUBLIC_API_URL=http://localhost:8022

# Canonical site origin, used for metadata/sitemap/robots — and, in the app, for
# `openExternal()` links back to the marketing site. Defaults to
# https://wi-mall.com when unset; set it explicitly, because a wrong value points
# every canonical and every sitemap entry at the wrong host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The API origin the ANDROID/iOS APP talks to. Read only by
# `npm run build:native`, which passes it through as NEXT_PUBLIC_API_URL for that
# build alone.
#
# Separate from NEXT_PUBLIC_API_URL on purpose: on a handset `localhost` is the
# handset, so the app needs an address the device can reach — and that address
# does not resolve from a desktop browser, so sharing the variable would break
# `npm run dev` for whoever set the app up.
#
# Whatever you put here must ALSO be in
# android/app/src/debug/res/xml/network_security_config.xml, or Android blocks
# the plain-HTTP request. Unset, the app just uses NEXT_PUBLIC_API_URL.
NATIVE_API_URL=

# ── Languages this app build ships ───────────────────────────────────────────
# A static export writes one complete HTML + RSC tree per locale and every one
# of them goes into the APK. Measured on this repo: ~11 MB each in out/, ~3.2 MB
# each compressed in the APK. All five were ~16 MB of a 20 MB download for a
# shopper who reads one language.
#
# Comma-separated, from: en, fr, pt, es, ar. Unknown codes are ignored and an
# empty value ships all five, which is also what happens if this is unset — so
# the WEB build is never affected by it.
#
#   en,fr           Cameroon's two official languages   -> APK ~10 MB
#   fr              French only                         -> APK ~7 MB
#   (unset)         all five                            -> APK ~20 MB
#
# ⚠ Dropping 'ar' removes the app's only right-to-left language, so RTL layout
#   becomes unreachable on a device even though the web still serves it.
APP_LOCALES=

# ─── Sign-in entry points ─────────────────────────────────────────────────────
# Customers have no password: they sign in through the WhatsApp or Telegram bot.
# With both of these unset the sign-in screen has no entry point at all, which
# matters far more in the app than on the web.

# WhatsApp bot number in E.164 (e.g. +237XXXXXXXXX). Falls back to the
# placeholder in src/lib/constants.ts, which is NOT a real number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Telegram bot username, without the @. Must match the backend's
# TELEGRAM_BOT_NAME. The API only serves this on an authenticated route, so the
# sign-in page needs its own copy. Empty renders the /login command as plain text
# instead of a link — the flow still works, it just costs the user a typed command.
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

# ─── Payments ─────────────────────────────────────────────────────────────────

# Stripe publishable key (pk_test_… / pk_live_…). Publishable keys are designed
# to be public — this is not a secret, and the matching SECRET key lives only in
# the backend.
#
# ⚠ Groundwork, not a working payment path. Checkout already offers a
# "Card (Visa / Mastercard)" option, but `initiatePayment` returns a
# `clientSecret` that no frontend has ever consumed — on web either. Setting this
# does not switch card payments on; building the flow (or removing the option) is
# still open. See MOBILE-APP-PLAN.md, Track B.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Agent app store listings ─────────────────────────────────────────────────
# Leave empty until published: the download buttons render disabled with a
# "Coming soon" pill rather than as dead links.
NEXT_PUBLIC_AGENT_APP_ANDROID_URL=
NEXT_PUBLIC_AGENT_APP_IOS_URL=
